{
  "name": "monolithic-sample",
  "version": "1.0.0",
  "description": "Production-grade Node.js modular monolithic architecture in pure JavaScript with enterprise standards and policy gates",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint . --ext .js --max-warnings 0",
    "lint:fix": "eslint . --ext .js --fix",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "format:fix": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:security": "npm audit --omit=dev"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "esm",
    "modular-monolith",
    "express",
    "production-grade",
    "clean-architecture",
    "enterprise"
  ],
  "author": "Enterprise Architecture Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.1.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
